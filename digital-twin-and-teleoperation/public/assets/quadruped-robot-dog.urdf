<?xml version="1.0"?>
<robot name="cyber_quadruped_final">
  <material name="body_white"><color rgba="0.9 0.92 0.95 1"/></material>
  <material name="armor_dark"><color rgba="0.12 0.14 0.16 1"/></material>
  <material name="joint_blue"><color rgba="0.12 0.35 0.65 1"/></material>
  <material name="leg_grey"><color rgba="0.5 0.52 0.55 1"/></material>
  <material name="foot_rubber"><color rgba="0.05 0.05 0.05 1"/></material>

  <!-- ==================== MAIN TRUNK ==================== -->
  <link name="trunk">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.4 0.18 0.09"/></geometry>
      <material name="body_white"/>
    </visual>
    <visual>
      <origin xyz="0.22 0 0.01" rpy="0 0.3 0"/>
      <geometry><box size="0.08 0.15 0.08"/></geometry>
      <material name="armor_dark"/>
    </visual>
    <visual>
      <origin xyz="-0.21 0 -0.01" rpy="0 -0.2 0"/>
      <geometry><box size="0.06 0.16 0.07"/></geometry>
      <material name="body_white"/>
    </visual>
    <visual>
      <origin xyz="0 0.095 0" rpy="0 0 0"/>
      <geometry><box size="0.32 0.015 0.07"/></geometry>
      <material name="armor_dark"/>
    </visual>
    <visual>
      <origin xyz="0 -0.095 0" rpy="0 0 0"/>
      <geometry><box size="0.32 0.015 0.07"/></geometry>
      <material name="armor_dark"/>
    </visual>
  </link>

  <!-- ==================== FRONT LEFT LEG ==================== -->
  <joint name="FL_hip_joint" type="revolute">
    <parent link="trunk"/>
    <child link="FL_hip"/>
    <origin xyz="0.17 0.09 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.8" upper="0.8" effort="30" velocity="4"/>
  </joint>
  <link name="FL_hip">
    <visual>
      <origin xyz="0 0.025 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.045" length="0.04"/></geometry>
      <material name="armor_dark"/>
    </visual>
    <visual>
      <origin xyz="0 0.046 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.046" length="0.005"/></geometry>
      <material name="joint_blue"/>
    </visual>
  </link>

  <joint name="FL_thigh_joint" type="revolute">
    <parent link="FL_hip"/>
    <child link="FL_thigh"/>
    <origin xyz="0 0.05 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="3.5" effort="40" velocity="4"/>
  </joint>
  <link name="FL_thigh">
    <visual>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.08"/></geometry>
      <material name="body_white"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry><cylinder radius="0.02" length="0.14"/></geometry>
      <material name="leg_grey"/>
    </visual>
  </link>

  <joint name="FL_shank_joint" type="revolute">
    <parent link="FL_thigh"/>
    <child link="FL_shank"/>
    <origin xyz="0 0 -0.16" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="-0.5" effort="40" velocity="5"/>
  </joint>
  <link name="FL_shank">
    <!-- 修复点：移除了多余的内层回转圆柱，精简单link内的多个visual节点，确保连接牢固 -->
    <visual>
      <origin xyz="0 0 -0.075" rpy="0 0 0"/>
      <geometry><cylinder radius="0.016" length="0.15"/></geometry>
      <material name="armor_dark"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><sphere radius="0.022"/></geometry>
      <material name="foot_rubber"/>
    </visual>
  </link>

  <!-- ==================== FRONT RIGHT LEG ==================== -->
  <joint name="FR_hip_joint" type="revolute">
    <parent link="trunk"/>
    <child link="FR_hip"/>
    <origin xyz="0.17 -0.09 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.8" upper="0.8" effort="30" velocity="4"/>
  </joint>
  <link name="FR_hip">
    <visual>
      <origin xyz="0 -0.025 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.045" length="0.04"/></geometry>
      <material name="armor_dark"/>
    </visual>
    <visual>
      <origin xyz="0 -0.046 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.046" length="0.005"/></geometry>
      <material name="joint_blue"/>
    </visual>
  </link>

  <joint name="FR_thigh_joint" type="revolute">
    <parent link="FR_hip"/>
    <child link="FR_thigh"/>
    <origin xyz="0 -0.05 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="3.5" effort="40" velocity="4"/>
  </joint>
  <link name="FR_thigh">
    <visual>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.08"/></geometry>
      <material name="body_white"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry><cylinder radius="0.02" length="0.14"/></geometry>
      <material name="leg_grey"/>
    </visual>
  </link>

  <joint name="FR_shank_joint" type="revolute">
    <parent link="FR_thigh"/>
    <child link="FR_shank"/>
    <origin xyz="0 0 -0.16" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="-0.5" effort="40" velocity="5"/>
  </joint>
  <link name="FR_shank">
    <visual>
      <origin xyz="0 0 -0.075" rpy="0 0 0"/>
      <geometry><cylinder radius="0.016" length="0.15"/></geometry>
      <material name="armor_dark"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><sphere radius="0.022"/></geometry>
      <material name="foot_rubber"/>
    </visual>
  </link>

  <!-- ==================== REAR LEFT LEG ==================== -->
  <joint name="RL_hip_joint" type="revolute">
    <parent link="trunk"/>
    <child link="RL_hip"/>
    <origin xyz="-0.17 0.09 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.8" upper="0.8" effort="30" velocity="4"/>
  </joint>
  <link name="RL_hip">
    <visual>
      <origin xyz="0 0.025 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.045" length="0.04"/></geometry>
      <material name="armor_dark"/>
    </visual>
    <visual>
      <origin xyz="0 0.046 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.046" length="0.005"/></geometry>
      <material name="joint_blue"/>
    </visual>
  </link>

  <joint name="RL_thigh_joint" type="revolute">
    <parent link="RL_hip"/>
    <child link="RL_thigh"/>
    <origin xyz="0 0.05 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="3.5" effort="40" velocity="4"/>
  </joint>
  <link name="RL_thigh">
    <visual>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.08"/></geometry>
      <material name="body_white"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry><cylinder radius="0.02" length="0.14"/></geometry>
      <material name="leg_grey"/>
    </visual>
  </link>

  <joint name="RL_shank_joint" type="revolute">
    <parent link="RL_thigh" />
    <child link="RL_shank"/>
    <origin xyz="0 0 -0.16" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="-0.5" effort="40" velocity="5"/>
  </joint>
  <link name="RL_shank">
    <visual>
      <origin xyz="0 0 -0.075" rpy="0 0 0"/>
      <geometry><cylinder radius="0.016" length="0.15"/></geometry>
      <material name="armor_dark"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><sphere radius="0.022"/></geometry>
      <material name="foot_rubber"/>
    </visual>
  </link>

  <!-- ==================== REAR RIGHT LEG ==================== -->
  <joint name="RR_hip_joint" type="revolute">
    <parent link="trunk"/>
    <child link="RR_hip"/>
    <origin xyz="-0.17 -0.09 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.8" upper="0.8" effort="30" velocity="4"/>
  </joint>
  <link name="RR_hip">
    <visual>
      <origin xyz="0 -0.025 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.045" length="0.04"/></geometry>
      <material name="armor_dark"/>
    </visual>
    <visual>
      <origin xyz="0 -0.046 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.046" length="0.005"/></geometry>
      <material name="joint_blue"/>
    </visual>
  </link>

  <joint name="RR_thigh_joint" type="revolute">
    <parent link="RR_hip"/>
    <child link="RR_thigh"/>
    <origin xyz="0 -0.05 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="3.5" effort="40" velocity="4"/>
  </joint>
  <link name="RR_thigh">
    <visual>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.08"/></geometry>
      <material name="body_white"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.1" rpy="0 0 0"/>
      <geometry><cylinder radius="0.02" length="0.14"/></geometry>
      <material name="leg_grey"/>
    </visual>
  </link>

  <joint name="RR_shank_joint" type="revolute">
    <parent link="RR_thigh"/>
    <child link="RR_shank"/>
    <origin xyz="0 0 -0.16" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="-0.5" effort="40" velocity="5"/>
  </joint>
  <link name="RR_shank">
    <visual>
      <origin xyz="0 0 -0.075" rpy="0 0 0"/>
      <geometry><cylinder radius="0.016" length="0.15"/></geometry>
      <material name="armor_dark"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><sphere radius="0.022"/></geometry>
      <material name="foot_rubber"/>
    </visual>
  </link>
</robot>
