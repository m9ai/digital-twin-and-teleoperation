<?xml version="1.0"?>
<robot name="pro_industrial_5axis_fixed">
  <material name="robot_blue"><color rgba="0.12 0.35 0.65 1"/></material>
  <material name="robot_dark"><color rgba="0.15 0.17 0.21 1"/></material>
  <material name="robot_grey"><color rgba="0.55 0.58 0.62 1"/></material>
  <material name="robot_silver"><color rgba="0.82 0.85 0.88 1"/></material>
  <material name="gripper_orange"><color rgba="0.96 0.48 0.09 1"/></material>
  <material name="pad_black"><color rgba="0.08 0.08 0.08 1"/></material>

  <!-- ==================== BASE ==================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.25 0.25 0.06"/></geometry>
      <material name="robot_dark"/>
    </visual>
  </link>

  <!-- ==================== LINK 1 ==================== -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="100" velocity="2"/>
  </joint>
  <link name="link_1">
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry><cylinder radius="0.07" length="0.2"/></geometry>
      <material name="robot_blue"/>
    </visual>
  </link>

  <!-- ==================== LINK 2 ==================== -->
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="100" velocity="2"/>
  </joint>
  <link name="link_2">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.075" length="0.08"/></geometry>
      <material name="robot_dark"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.085" length="0.02"/></geometry>
      <material name="robot_blue"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry><cylinder radius="0.055" length="0.4"/></geometry>
      <material name="robot_silver"/>
    </visual>
  </link>

  <!-- ==================== LINK 3 ==================== -->
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 0.4" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="80" velocity="2.5"/>
  </joint>
  <link name="link_3">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.065" length="0.08"/></geometry>
      <material name="robot_dark"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.07" length="0.01"/></geometry>
      <material name="robot_blue"/>
    </visual>
    <visual>
      <origin xyz="0.175 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.045" length="0.35"/></geometry>
      <material name="robot_grey"/>
    </visual>
  </link>

  <!-- ==================== LINK 4 ==================== -->
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0.35 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14" upper="3.14" effort="50" velocity="3"/>
  </joint>
  <link name="link_4">
    <visual>
      <origin xyz="0.025 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.05" length="0.05"/></geometry>
      <material name="robot_blue"/>
    </visual>
    <visual>
      <origin xyz="0.075 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
      <material name="robot_dark"/>
    </visual>
  </link>

  <!-- ==================== LINK 5 ==================== -->
  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="0.1 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="30" velocity="3"/>
  </joint>
  <link name="link_5">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.038"/></geometry>
      <material name="robot_dark"/>
    </visual>
    <visual>
      <origin xyz="0.015 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.035" length="0.03"/></geometry>
      <material name="robot_silver"/>
    </visual>
  </link>

  <!-- ==================== GRIPPER BASE ==================== -->
  <!-- 🌟 此处已将 child_link name 修正为标准的 child link 语法 -->
  <joint name="joint_gripper_base" type="fixed">
    <parent link="link_5"/>
    <child link="gripper_base"/>
    <origin xyz="0.03 0 0" rpy="0 0 0"/>
  </joint>
  <link name="gripper_base">
    <visual>
      <origin xyz="0.015 0 0" rpy="0 1.5708 0"/>
      <geometry><box size="0.02 0.08 0.03"/></geometry>
      <material name="gripper_orange"/>
    </visual>
  </link>

  <!-- ==================== GRIPPER FINGERS ==================== -->
  <!-- 左手指 -->
  <joint name="joint_finger_left" type="prismatic">
    <parent link="gripper_base"/>
    <child link="finger_left"/>
    <origin xyz="0.03 -0.025 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.02" effort="20" velocity="0.1"/>
  </joint>
  <link name="finger_left">
    <visual>
      <origin xyz="0.02 0 0" rpy="0 0 0"/>
      <geometry><box size="0.04 0.008 0.018"/></geometry>
      <material name="robot_dark"/>
    </visual>
    <visual>
      <origin xyz="0.035 0.005 0" rpy="0 0 0"/>
      <geometry><box size="0.01 0.003 0.014"/></geometry>
      <material name="pad_black"/>
    </visual>
  </link>

  <!-- 右手指 -->
  <joint name="joint_finger_right" type="prismatic">
    <parent link="gripper_base"/>
    <child link="finger_right"/>
    <origin xyz="0.03 0.025 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.02" effort="20" velocity="0.1"/>
  </joint>
  <link name="finger_right">
    <visual>
      <origin xyz="0.02 0 0" rpy="0 0 0"/>
      <geometry><box size="0.04 0.008 0.018"/></geometry>
      <material name="robot_dark"/>
    </visual>
    <visual>
      <origin xyz="0.035 -0.005 0" rpy="0 0 0"/>
      <geometry><box size="0.01 0.003 0.014"/></geometry>
      <material name="pad_black"/>
    </visual>
  </link>
</robot>
