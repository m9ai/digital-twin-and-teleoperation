<?xml version="1.0"?>
<robot name="industrial_5axis_arm">
  <material name="base_blue">
    <color rgba="0.12 0.35 0.65 1" />
  </material>
  <material name="joint_dark">
    <color rgba="0.15 0.17 0.21 1" />
  </material>
  <material name="link_grey">
    <color rgba="0.62 0.66 0.71 1" />
  </material>
  <material name="link_silver">
    <color rgba="0.75 0.78 0.8 1" />
  </material>
  <material name="tool_orange">
    <color rgba="0.96 0.48 0.09 1" />
  </material>

  <!-- Base link -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.45 0.45 0.15" />
      </geometry>
      <material name="base_blue" />
    </visual>
    <collision>
      <geometry>
        <box size="0.45 0.45 0.15" />
      </geometry>
    </collision>
  </link>

  <!-- Joint 1 housing (waist) -->
  <link name="joint1_housing">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.1" />
      </geometry>
      <material name="joint_dark" />
    </visual>
  </link>

  <joint name="base_to_joint1_housing" type="fixed">
    <parent link="base_link" />
    <child link="joint1_housing" />
    <origin xyz="0 0 0.15" rpy="0 0 0" />
  </joint>

  <!-- Link 1: vertical column -->
  <link name="link1">
    <visual>
      <origin xyz="0 0 0.25" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.08" length="0.5" />
      </geometry>
      <material name="link_grey" />
    </visual>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="joint1_housing" />
    <child link="link1" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="3.14" effort="100" velocity="2" />
  </joint>

  <!-- Joint 2 housing (shoulder) -->
  <link name="joint2_housing">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.075" />
      </geometry>
      <material name="joint_dark" />
    </visual>
  </link>

  <joint name="link1_to_joint2_housing" type="fixed">
    <parent link="link1" />
    <child link="joint2_housing" />
    <origin xyz="0 0 0.5" rpy="0 0 0" />
  </joint>

  <!-- Link 2: upper arm (cylinder default axis is z; rotate -90 deg around y to align with x) -->
  <link name="link2">
    <visual>
      <origin xyz="0.275 0 0" rpy="0 -1.5708 0" />
      <geometry>
        <cylinder radius="0.06" length="0.55" />
      </geometry>
      <material name="link_silver" />
    </visual>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="joint2_housing" />
    <child link="link2" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.57" upper="1.57" effort="80" velocity="2" />
  </joint>

  <!-- Joint 3 housing (elbow) -->
  <link name="joint3_housing">
    <visual>
      <geometry>
        <sphere radius="0.065" />
      </geometry>
      <material name="joint_dark" />
    </visual>
  </link>

  <joint name="link2_to_joint3_housing" type="fixed">
    <parent link="link2" />
    <child link="joint3_housing" />
    <origin xyz="0.55 0 0" rpy="0 0 0" />
  </joint>

  <!-- Link 3: forearm (cylinder default axis is z; rotate -90 deg around y to align with x) -->
  <link name="link3">
    <visual>
      <origin xyz="0.225 0 0" rpy="0 -1.5708 0" />
      <geometry>
        <cylinder radius="0.05" length="0.45" />
      </geometry>
      <material name="link_grey" />
    </visual>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="joint3_housing" />
    <child link="link3" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.57" upper="1.57" effort="60" velocity="2.5" />
  </joint>

  <!-- Joint 4 housing (wrist roll) -->
  <link name="joint4_housing">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.055" length="0.08" />
      </geometry>
      <material name="joint_dark" />
    </visual>
  </link>

  <joint name="link3_to_joint4_housing" type="fixed">
    <parent link="link3" />
    <child link="joint4_housing" />
    <origin xyz="0.45 0 0" rpy="0 0 0" />
  </joint>

  <!-- Link 4: wrist segment -->
  <link name="link4">
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.04" length="0.2" />
      </geometry>
      <material name="link_silver" />
    </visual>
  </link>

  <joint name="joint4" type="revolute">
    <parent link="joint4_housing" />
    <child link="link4" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="3.14" effort="30" velocity="3" />
  </joint>

  <!-- Joint 5 housing (wrist bend) -->
  <link name="joint5_housing">
    <visual>
      <geometry>
        <sphere radius="0.045" />
      </geometry>
      <material name="joint_dark" />
    </visual>
  </link>

  <joint name="link4_to_joint5_housing" type="fixed">
    <parent link="link4" />
    <child link="joint5_housing" />
    <origin xyz="0 0 0.2" rpy="0 0 0" />
  </joint>

  <!-- Link 5: tool flange -->
  <link name="link5">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.035" length="0.12" />
      </geometry>
      <material name="link_grey" />
    </visual>
  </link>

  <joint name="joint5" type="revolute">
    <parent link="joint5_housing" />
    <child link="link5" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-1.57" upper="1.57" effort="20" velocity="3" />
  </joint>

  <!-- Tool / end effector -->
  <link name="tool0">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0" />
      <geometry>
        <box size="0.04 0.04 0.08" />
      </geometry>
      <material name="tool_orange" />
    </visual>
  </link>

  <joint name="link5_to_tool0" type="fixed">
    <parent link="link5" />
    <child link="tool0" />
    <origin xyz="0 0 0.12" rpy="0 0 0" />
  </joint>
</robot>
